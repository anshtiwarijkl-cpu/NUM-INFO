{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/vehicle/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/bulk",
      "dest": "app.py",
      "methods": ["POST"]
    },
    {
      "src": "/health",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
